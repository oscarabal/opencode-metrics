# Copy to .env and set your own values. .env is ignored by git.
GRAFANA_ADMIN_PASSWORD=change-me

# Optional: where OpenCode keeps opencode.db.
# Default: ~/.local/share/opencode (USERPROFILE on Windows, HOME elsewhere)
# OPENCODE_DATA_DIR=

# Optional: OpenCode's cache folder, where models.json holds each model's context limit.
# Default: ~/.cache/opencode
# OPENCODE_CACHE_DIR=

# Optional: context limits (in tokens) for models that models.json does not list, such as
# custom providers. Comma-separated provider/model=tokens pairs.
# CONTEXT_LIMITS=myprovider/my-model=200000,github-copilot/some-model=128000

# Optional: OpenCode's global commands folder. The exporter recognises a command from the opening of
# its template and counts it with the skills. Commands defined inside a project are not seen.
# Default: ~/.config/opencode/commands
# OPENCODE_COMMANDS_DIR=
